    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses Face ID or a passcode to keep your diary private, verifying you each time the app opens."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Face ID 或密码保护你的日记隐私，每次打开 App 时需要验证身份。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records where a diary entry was written. Used once while writing — never tracked continuously."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录这篇日记写于哪里，仅在写日记时使用一次，不会持续追踪。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording a voice diary needs the microphone. Audio stays on your device and your own iCloud — never uploaded to us or any third party."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制语音日记需要使用麦克风。录音只保存在你的设备和你自己的 iCloud，不会上传给我们或第三方。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to transcribe your voice into text. Recognition runs entirely on your device and is never uploaded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把语音转写成文字日记，识别全部在本机完成，不会上传。"
          }
        }
      }
    }
